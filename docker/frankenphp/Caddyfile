# FrankenPHP in classic mode (no worker), see docs/DECISIONS.md D9.
# https://frankenphp.dev/docs/config

{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp
}

# SERVER_NAME=":8080" serves plain HTTP (local dev).
# A real domain name enables automatic HTTPS (production).
{$SERVER_NAME:localhost} {
	root /app/public
	encode zstd br gzip

	# "?" sets a default: a header set by Laravel wins (e.g. the stricter
	# Referrer-Policy of the invitation pages). One directive per header:
	# in a single block, one header set by Laravel cancels all the defaults.
	header ?X-Content-Type-Options "nosniff"
	header ?X-Frame-Options "DENY"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header {
		-Server
		-X-Powered-By
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
